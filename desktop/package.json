{
  "name": "file-ferry-desktop",
  "productName": "ferry",
  "version": "0.0.0",
  "description": "Electron desktop shell for file-ferry (vNext foundation)",
  "type": "module",
  "main": "dist/electron/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "npm run build:shared && npm run build:electron && npm run build:renderer",
    "build:shared": "tsc -p tsconfig.shared.json",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "tsc -p tsconfig.renderer.json --noEmit && vite build",
    "dev": "npm run build:shared && concurrently -k \"tsc -p tsconfig.electron.json --watch\" \"vite\"",
    "start:built": "npm run build && node scripts/start-built.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.tests.json",
    "lint": "npm run lint:eslint && npm run lint:anti-slop",
    "lint:eslint": "eslint electron renderer shared tests",
    "lint:anti-slop": "oxlint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "build:sidecar": "bash ../scripts/build-sidecar.sh",
    "package:mac": "npm run build:sidecar && npm run build && electron-builder --mac --config build/electron-builder.yml",
    "package:mac:local": "npm run build:sidecar && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false bash ../scripts/package-mac-local.sh",
    "package:win": "npm run build && electron-builder --win --config build/electron-builder.yml",
    "package:linux": "npm run build && electron-builder --linux --config build/electron-builder.yml"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint-react/eslint-plugin": "5.19.1",
    "@oxlint/plugins": "^1.80.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.80.0",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
