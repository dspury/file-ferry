{
  "name": "file-ferry-desktop",
  "productName": "ferry",
  "version": "0.0.0",
  "description": "Electron desktop shell for file-ferry (vNext foundation)",
  "main": "dist/electron/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "npm run build:shared && npm run build:electron && npm run build:renderer",
    "build:shared": "tsc -p tsconfig.shared.json",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "tsc -p tsconfig.renderer.json --noEmit && vite build",
    "dev": "npm run build:shared && concurrently -k \"tsc -p tsconfig.electron.json --watch\" \"vite\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.json && tsc -p tsconfig.tests.json",
    "lint": "npm run lint:eslint && npm run lint:anti-slop",
    "lint:eslint": "eslint electron renderer shared tests --ext .ts,.tsx",
    "lint:anti-slop": "oxlint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "build:sidecar": "bash ../scripts/build-sidecar.sh",
    "package:mac": "npm run build:sidecar && npm run build && electron-builder --mac --config build/electron-builder.yml",
    "package:win": "npm run build && electron-builder --win --config build/electron-builder.yml",
    "package:linux": "npm run build && electron-builder --linux --config build/electron-builder.yml"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.80.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "oxlint": "^1.80.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
